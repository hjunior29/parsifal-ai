# Copy to .env and adjust. Never commit the .env file.

# Generate a real key for any instance reachable by others, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Directory holding the SQLite database, uploaded media and collected static files.
# Defaults to ./data next to the repository when unset.
# PARSIFAL_DATA_DIR=/var/lib/parsifal

# Defaults to sqlite:///<PARSIFAL_DATA_DIR>/parsifal.sqlite3 when unset.
# DATABASE_URL=sqlite:////absolute/path/to/parsifal.sqlite3

# Email (used for password reset and co-author invites). Local settings print emails to the console.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=user
# EMAIL_HOST_PASSWORD=secret
# EMAIL_USE_TLS=True

# Optional: Scopus search in the conducting phase.
# ELSEVIER_API_KEY=
