# Copy to .env and adjust. Never commit the .env file.

# Generate a real key for any instance reachable by others, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Allow anyone to create an account (default: only the admin creates users or invites co-authors).
PARSIFAL_ALLOW_SIGNUP=False

# Production settings (DJANGO_SETTINGS_MODULE=parsifal.settings.production, used by Docker):
# set to True when served over HTTPS to enable secure cookies, HSTS and the HTTPS redirect.
PARSIFAL_HTTPS=False
# Origins allowed for CSRF when behind a reverse proxy on another host, e.g. https://parsifal.example.org
# CSRF_TRUSTED_ORIGINS=

# Directory holding the SQLite database, uploaded media and collected static files.
# Defaults to ./data next to the repository when unset.
# PARSIFAL_DATA_DIR=/var/lib/parsifal

# Defaults to sqlite:///<PARSIFAL_DATA_DIR>/parsifal.sqlite3 when unset.
# DATABASE_URL=sqlite:////absolute/path/to/parsifal.sqlite3

# Email (used for password reset and co-author invites). Without EMAIL_HOST, e-mails are printed to the log.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DEFAULT_FROM_EMAIL=Parsifal <noreply@example.org>
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=user
# EMAIL_HOST_PASSWORD=secret
# EMAIL_USE_TLS=True
